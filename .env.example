# Copy to .env.local and fill in. Validated by src/env.ts; see docs/05-engineering/CONVENTIONS.md §6.
# An empty value counts as not set: required variables fail at boot, optional ones use their default.

# --- Required ---

# Postgres connection. Local: docker compose up -d. Production: Neon pooled URL (-pooler).
# If port 5432 is taken, put POSTGRES_PORT=<port> in .env (Compose does not read .env.local)
# and use that port in both database URLs here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ridgeline
# Chat, embeddings and data generation.
OPENAI_API_KEY=
# Session encryption, at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=
# JSON array of demo accounts; role is one of sales, hr, ops, admin. Example:
# [{"id":"sales","role":"sales","passwordHash":"$2b$..."}]
DEMO_ACCOUNTS_JSON=

# --- Migrations ---

# Direct (non-pooled) connection used by drizzle-kit. Production: Neon direct URL.
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/ridgeline

# --- LLM (optional) ---

# Any OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval and guardrails (optional) ---

# Minimum similarity for the answer gate, 0 to 1.
SIM_FLOOR=0.30
MAX_QUESTION_CHARS=500
MAX_OUTPUT_TOKENS=700
RATE_LIMIT_ACCOUNT_PER_HOUR=20
RATE_LIMIT_IP_PER_HOUR=40
DAILY_TOKEN_BUDGET=400000

# --- Eval and data generation (CLIs only) ---

# Judge and question generation.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-haiku-5-5
DATAGEN_MODEL=gpt-5-mini
DATAGEN_QUESTIONS_MODEL=claude-haiku-5-5

# --- Client ---

# local or production; drives UI banners.
NEXT_PUBLIC_APP_ENV=local
