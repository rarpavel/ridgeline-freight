{
  "name": "ridgeline-freight",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "hash-password": "tsx scripts/hash-password.ts",
    "ingest": "tsx --conditions=react-server scripts/ingest.ts",
    "datagen:check": "tsx --conditions=react-server scripts/data-gen/check.ts",
    "datagen:world": "tsx --conditions=react-server scripts/data-gen/world.ts",
    "datagen:registry": "tsx --conditions=react-server scripts/data-gen/registry.ts",
    "datagen:validate-registry": "tsx --conditions=react-server scripts/data-gen/validate-registry.ts",
    "datagen:docs": "tsx --conditions=react-server scripts/data-gen/docs.ts",
    "datagen:rate-sheets": "tsx --conditions=react-server scripts/data-gen/rate-sheets.ts",
    "datagen:render": "tsx --conditions=react-server scripts/data-gen/render.ts",
    "datagen:validate": "tsx --conditions=react-server scripts/data-gen/validate.ts",
    "datagen:questions": "tsx --conditions=react-server scripts/data-gen/questions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "iron-session": "9.0.1",
    "js-tiktoken": "1.0.21",
    "lucide-react": "^1.66.0",
    "mammoth": "1.13.0",
    "next": "16.4.3",
    "openai": "7.47.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "docx": "9.15.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jszip": "3.10.2",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8",
    "vitest": "5.0.5"
  }
}
