  "glossary": {
    "detention": "Charge assessed when a driver is held beyond the allotted free time at pickup or delivery.",
    "layover": "Charge paid when a driver is held overnight because a load cannot be picked up or delivered as scheduled.",
    "accessorial": "Additional services or charges outside standard linehaul (e.g., liftgate, inside delivery).",
    "tonu": "Truck Ordered Not Used: cancellation fee charged when a dispatched truck is not loaded.",
    "lumperFee": "Fee charged for third-party labor used to load or unload freight at a facility.",
    "osd": "Over, Short & Damaged — discrepancies between shipped and received goods noted on delivery.",
    "hazmat": "Hazardous materials classification for goods that require special handling and documentation.",
    "reefer": "Refrigerated trailer or service used to transport temperature-sensitive freight."
  }
